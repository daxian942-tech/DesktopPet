{
  "name": "desktop-pet",
  "version": "1.0.1",
  "private": true,
  "description": "DesktopPet custom animal companion with pet care and three keyboard finishes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "vite build --config vite.web.config.ts && node scripts/postbuild-kurocat-seo.mjs",
    "build:android-web": "vite build --config vite.android.config.ts",
    "build:studio": "esbuild tools/species-preview-entry.ts --bundle --format=iife --platform=browser --outfile=tools/species-renderer.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@types/three": "^0.187.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
